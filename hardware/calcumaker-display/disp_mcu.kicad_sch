	)
	(text "PA14 is shared SWCLK/BOOT0. R4 limits contention; main MCU releases DISP_BOOT for SWD.\nSet nBOOT_SEL=0 for external BOOT0. PA9/PA10 are dedicated pads 19/21.\nC8 is the local VDD bypass; C9/C10 distribute 3V3 at the interface / optional OLED.\nCortex-M0+ has no SWO; J3.6 deliberately unused."
		(exclude_from_sim no)
		(at 25.4 223.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9ff5a34c-2d79-46a9-b4b2-e7a1df73e3f6")
	)
