	(text "Column pull-up -> diode ANODE -> CATHODE -> switch -> selected LOW row.\nUnselected rows are high impedance; all rows go low for column EXTI wake.\nRGB data runs left to right. Each SK6812MINI-E has a 100nF bypass capacitor.\nRow4 omits COL6 (upper half of 2U ENTER); its data chain bridges the gap.\nShared globals: COL1..10, VLED, GND. ROW/DIN/DOUT are hierarchical."
		(exclude_from_sim no)
		(at 25.4 241.3 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "686b0277-eb80-4cba-a60f-b2ce94c4edda")
	)
