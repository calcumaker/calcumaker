		(uuid "8966daf4-c0ee-47aa-8c94-7755919d5864")
	)
	(text "R7 defaults P-FET off. Q2 turns it on when LED_EN is high.\nBefore removing VLED: hold LED_RAW low, then clear LED_EN.\nVSYS is unregulated battery/system power; see DESIGN.md for the unresolved\nSK6812 voltage/headroom and LVC input-threshold validation before fabrication.\nCap total brightness to connector/cell current limits. Each LED has local bypass."
		(exclude_from_sim no)
		(at 246.38 76.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ef1b2b3b-2ed1-4807-a5d4-f7fc6271ba6b")
	)
