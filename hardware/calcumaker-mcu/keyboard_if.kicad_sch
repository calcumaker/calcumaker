	)
	(text "DF40 stack and 16-way FFC have the same signal nets.\nUART_TX = main TX -> keyboard RX; UART_RX = keyboard TX -> main RX.\nUse a pin-1-to-pin-1 cable; verify contact orientation against the physical connectors.\nFFC pins 15/16 are deliberately unused. VSYS is the charger SYS output.\nKB_BOOT0 shares G031 PA14/SWCLK: main MCU must release it for SWD."
		(exclude_from_sim no)
		(at 25.4 127 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ea0e2968-5bb9-4574-b923-678ddcb99b5f")
	)
